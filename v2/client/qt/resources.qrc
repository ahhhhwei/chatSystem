    <qresource prefix="/chat">
        <file alias="logo.png">resources/images/logo.png</file>
        <file alias="default-avatar.png">resources/images/default-avatar.png</file>
        <file alias="group-avatar.png">resources/images/group-avatar.png</file>
        <file alias="file.png">resources/images/file.png</file>
        <file alias="image.png">resources/images/image.png</file>
    </qresource>
</RCC>
